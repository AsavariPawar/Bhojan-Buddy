rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isOrganizer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer';
    }
    match /users/{uid} {
      allow read: if isSelf(uid) || isOrganizer();
      allow create: if isSelf(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }
    match /menus/{menuId} {
      allow read: if signedIn();
      allow create: if isOrganizer()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.mealType in ['breakfast','lunch','snacks','dinner'];
      allow update: if isOrganizer()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.mealType in ['breakfast','lunch','snacks','dinner'];
      allow delete: if isOrganizer();
    }
    match /selections/{selectionId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isOrganizer());
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.mealType in ['breakfast','lunch','snacks','dinner']
        && exists(/databases/$(database)/documents/menus/$(request.resource.data.menuId));
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.date == resource.data.date
        && request.resource.data.mealType == resource.data.mealType
        && request.resource.data.menuId == resource.data.menuId
        && request.resource.data.mealTitle == resource.data.mealTitle
        && request.resource.data.status in ['confirmed','cancelled'];
      allow delete: if isOrganizer();
    }
  }
}